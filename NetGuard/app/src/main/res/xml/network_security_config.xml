<?xml version="1.0" encoding="utf-8"?>
<!-- راوترات WE/الراوترات المنزلية تستخدم HTTP على 192.168.x.x بدون شهادة.
     نسمح بذلك للشبكات المحلية فقط. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.1.1</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">192.168.1.254</domain>
        <domain includeSubdomains="true">10.0.0.1</domain>
        <domain includeSubdomains="true">10.0.0.138</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
