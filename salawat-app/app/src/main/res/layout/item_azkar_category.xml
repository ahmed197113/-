<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <TextView
        android:id="@+id/textCategoryNumber"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_number_badge"
        android:gravity="center"
        android:textAppearance="@style/Text.LabelMedium"
        android:textColor="?attr/brandAccentText" />

    <TextView
        android:id="@+id/textCategoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:textAppearance="@style/Text.BodyLarge"
        android:textColor="@color/text_primary_light" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_next"
        app:tint="@color/text_secondary_light" />
</LinearLayout>
