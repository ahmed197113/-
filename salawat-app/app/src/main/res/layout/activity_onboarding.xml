<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:orientation="vertical">

    <ViewFlipper
        android:id="@+id/flipper"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:inAnimation="@android:anim/fade_in"
        android:outAnimation="@android:anim/fade_out">

        <!-- Step 1: welcome -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="120dp"
                android:layout_height="120dp"
                app:cardCornerRadius="32dp"
                app:cardElevation="4dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_app_icon" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/title_main"
                android:textAppearance="@style/Text.Headline"
                android:textColor="?attr/brandAccentText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_welcome"
                android:textAppearance="@style/Text.BodyLarge"
                android:textColor="@color/text_secondary_light" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:lineSpacingMultiplier="1.5"
                android:text="@string/onboarding_features"
                android:textAppearance="@style/Text.BodyLarge"
                android:textColor="@color/text_primary_light" />
        </LinearLayout>

        <!-- Step 2: location -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_location"
                app:tint="?attr/brandAccentText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_location_title"
                android:textAppearance="@style/Text.Headline"
                android:textColor="@color/text_primary_light" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/onboarding_location_text"
                android:textAppearance="@style/Text.BodyLarge"
                android:textColor="@color/text_secondary_light" />

            <Button
                android:id="@+id/btnOnboardingLocation"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/location_set"
                app:icon="@drawable/ic_location"
                app:iconGravity="textStart" />

            <TextView
                android:id="@+id/textOnboardingPlace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:drawablePadding="6dp"
                android:gravity="center"
                android:textAppearance="@style/Text.TitleSmall"
                android:textColor="?attr/brandAccentText"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Step 3: alerts -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <ImageView
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:background="@drawable/bg_icon_circle"
                android:importantForAccessibility="no"
                android:padding="24dp"
                android:src="@drawable/ic_bell"
                app:tint="?attr/brandAccentText" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/onboarding_alerts_title"
                android:textAppearance="@style/Text.Headline"
                android:textColor="@color/text_primary_light" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchOnboardingAdhan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="60dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/onboarding_adhan"
                        android:textAppearance="@style/Text.TitleSmall" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/outline" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchOnboardingReminder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="60dp"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="@string/onboarding_reminder"
                        android:textAppearance="@style/Text.TitleSmall" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/Hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/onboarding_alerts_hint" />
        </LinearLayout>
    </ViewFlipper>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="20dp">

        <Button
            android:id="@+id/btnOnboardingSkip"
            style="@style/Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_skip" />

        <LinearLayout
            android:id="@+id/dots"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal" />

        <Button
            android:id="@+id/btnOnboardingNext"
            style="@style/Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:text="@string/onboarding_next" />
    </LinearLayout>
</LinearLayout>
