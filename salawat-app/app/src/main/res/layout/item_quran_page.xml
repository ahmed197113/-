<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:background="@drawable/page_frame"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/textPageText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/amiri_quran"
            app:fontFamily="@font/amiri_quran"
            android:gravity="start"
            android:layoutDirection="rtl"
            android:lineSpacingMultiplier="1.35"
            android:textColor="@color/text_primary_light"
            android:textColorHighlight="@android:color/transparent"
            android:textDirection="rtl"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/textPageNumber"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/accent_text"
            android:textSize="13sp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
