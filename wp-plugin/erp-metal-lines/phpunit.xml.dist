<?xml version="1.0"?>
<phpunit bootstrap="tests/bootstrap.php" colors="false" beStrictAboutOutputDuringTests="false" convertDeprecationsToExceptions="true">
    <testsuites>
        <testsuite name="erp">
            <directory prefix="test-" suffix=".php">tests/</directory>
        </testsuite>
    </testsuites>
</phpunit>
